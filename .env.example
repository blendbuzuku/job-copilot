# Copy this file to .env.
#
# Anthropic API key from https://console.anthropic.com (needs a few dollars of credit).
# Leave it empty to run in free DEMO MODE: the app works, but with example answers
# instead of real AI.
ANTHROPIC_API_KEY=

# Which Claude model to use. claude-opus-5 gives the best results;
# claude-sonnet-5 is cheaper if you want to save money while developing.
CLAUDE_MODEL=claude-opus-5
